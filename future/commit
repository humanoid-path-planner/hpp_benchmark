# assume folder structure src/hpp_benchmark/<date_of_benchmark>
# and "src" contains all the relevant packages
{
  CURRENT_DIR=$PWD;
  cd ../../;
  (for folder in */; do
    commit=$(git -C "$folder" rev-parse HEAD 2> /dev/null) || continue;
    echo "${folder%/}:$commit";
  done) > "$CURRENT_DIR/commit";
  exit
}
